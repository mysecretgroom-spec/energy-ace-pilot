    "issuer": "https://yobyzsgqnoaxvfsbpwkp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "d-balepro",
      "version": "0.1.0",
      "title": "Débalepro"
    },
    "tools": [
      {
        "name": "list_clients",
        "title": "Consulter mes clients",
        "description": "List a page of your own clients with names, city and agency association, without private notes or documents.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Number of clients, at most 50."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0,
              "description": "Pagination offset."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_appointments",
        "title": "Consulter mes rendez-vous",
        "description": "Read your own appointments in a date range of up to 31 days, including status and client reference.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time",
              "description": "Inclusive start as ISO timestamp with timezone."
            },
            "end": {
              "type": "string",
              "format": "date-time",
              "description": "Exclusive end as ISO timestamp with timezone; at most 31 days after start."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum appointments returned, at most 50."
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
